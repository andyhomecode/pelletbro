# Required
PETLIBRO_EMAIL=you@example.com
PETLIBRO_PASSWORD=yourpassword

# Optional — if unset, you must pass ?device_sn= on each request
# Run GET /devices to find your serial number
PETLIBRO_DEVICE_SN=

# Optional — leave blank to disable auth (safe on a private network)
# Set to a long random string if the service is reachable from the internet
API_KEY=
